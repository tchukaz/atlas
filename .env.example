# Copy to .env and fill in before starting the server.

PORT=3000

# Public origin every tracking link is built from. No trailing slash.
SITE_URL=https://atlashouseng.com

# Where /go/<code> sends people. Country code, no plus sign.
WHATSAPP_NUMBER=2348026883536

# Used once, to create the first Owner account on an empty database. After that
# people sign in with their own email and password, and this is only a fallback.
ADMIN_PASSWORD=
OWNER_EMAIL=owner@atlashouseng.com

# Salt for hashing visitor IPs. Generate once and keep it:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# Changing it makes past visitors look new, inflating unique-click counts.
IP_SALT=

# MongoDB. A free Atlas cluster is enough and gives a replica set, which is what
# lets booking overlap checks run in a transaction — a standalone mongod cannot,
# and two staff booking at once could then double-book a bedroom.
#
# End it with a database name. Without one, Mongoose quietly uses "test", so
# changing the name later makes every existing record look like it vanished.
MONGODB_URI=

# Guest photos and documents. Files are served only through an authenticated
# route, never as public URLs, wherever they are stored.
#
# With the four R2 values set, uploads go to Cloudflare R2 — 10GB free, no
# egress charges, and files survive a redeploy or a wiped server. Leave them
# blank and uploads fall back to local disk, which is fine for development but
# means the files and the database can drift apart.
R2_ACCOUNT_ID="7ec26f1fd8edd79ca6a7834735b9fbc1"
# The name you typed when creating the bucket in the Cloudflare R2 dashboard,
# e.g. atlas-house. Not an ID — R2 does not generate one for you.
R2_BUCKET="atlas"
R2_ACCESS_KEY_ID="ab3b806b5ffbb72afcb7380774cbaf39"
R2_SECRET_ACCESS_KEY="f09a20d1aa1acaf759f3624cb16aee2e82f1134ca801e9273d3c79e08d4b51b9"

# Only used when R2 is not configured.
UPLOAD_DIR=data/uploads
IMAGE_MAX_WIDTH=1600
IMAGE_QUALITY=80
MAX_UPLOAD_MB=15
# PDFs are stored as sent — nothing shrinks them — so they are capped separately.
MAX_PDF_MB=2

# Signup opens before the race starts, so day 1 is not spent recruiting.
SIGNUP_OPENS=2026-09-23
CHALLENGE_START=2026-09-26
CHALLENGE_END=2026-10-03
REWARD_PER_BOOKING=5000
GRAND_PRIZE=one free night at Atlas House

# Resend. The sending domain must be verified there first (DKIM/SPF DNS records).
# Without a key the server still runs and simply logs the emails it would send.
RESEND_API_KEY=
EMAIL_FROM=Atlas House <noreply@atlashouseng.com>
EMAIL_REPLY_TO=
REMINDER_HOUR=9

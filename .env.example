# Copy to .env and fill in before starting the server.

PORT=3000

# Public origin the tracking links are built from. No trailing slash.
SITE_URL=https://atlashouseng.com

# Where /go/<code> sends people. Country code, no plus sign.
WHATSAPP_NUMBER=2348026883536

# Gate for /admin. Pick something long; there is no account recovery.
ADMIN_PASSWORD=

# Salt for hashing visitor IPs. Generate once and keep it:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# Changing it makes past visitors look new, inflating the unique-click count.
IP_SALT=

CHALLENGE_START=2026-09-23
CHALLENGE_END=2026-09-30
REWARD_PER_BOOKING=10000
